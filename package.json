{
  "name": "centre",
  "productName": "Centre",
  "version": "1.0.0",
  "description": "Gestion du centre de soutien",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "ma.centre.app",
    "productName": "Centre",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "app.js",
      "data-validation.js",
      "data-store.js",
      "security.js",
      "save-queue.js",
      "shutdown-coordinator.js",
      "onedrive-warning.js",
      "runtime-paths.js",
      "startup-license.js",
      "license-verification.js",
      "device-fingerprint.js",
      "license-activation.js",
      "license-store.js",
      "trusted-keys.js",
      "fonts/**/*",
      "!tools/**",
      "!test/**",
      "!certs/**",
      "!keys/**",
      "!signing/**",
      "!.rollback/**",
      "!coverage/**",
      "!dist/**",
      "!out/**",
      "!**/*.pem",
      "!**/*.key",
      "!**/*.p12",
      "!**/*.pfx",
      "!**/*.tmp",
      "!**/*.log",
      "!**/*.test.js",
      "!**/.env",
      "!**/id_rsa",
      "!**/id_ed25519",
      "!license.json",
      "!device-binding.json",
      "!**/license-issuer.js",
      "!**/issue-license.js",
      "!*.bat",
      "!README.txt",
      "!TEST_ISOLATION.md",
      "!PHASE4_INTEGRATION.md"
    ],
    "win": { "target": "nsis" }
  }
}
